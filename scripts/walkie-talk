#!/bin/sh
# Locate uv and run the /walkie:talk capture. Invoked by commands/talk.md through
# /bin/sh, so it works even when the parent process has a bare PATH.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# The host this runs under, named by the command file that invoked it. Passed as
# an argument rather than a `VAR=value` prefix, which a `Bash(sh:*)` permission
# rule does not match; telemetry records it as the session's harness.
if [ $# -gt 0 ]; then
  WALKIE_HARNESS=$1
  export WALKIE_HARNESS
fi

run() { exec "$1" run --directory "$root" --quiet walkie-talk; }

[ -n "${WALKIE_UV:-}" ] && [ -x "${WALKIE_UV:-}" ] && run "$WALKIE_UV"

found=$(command -v uv 2>/dev/null) && [ -n "$found" ] && run "$found"

for candidate in "$HOME/.local/bin/uv" /opt/homebrew/bin/uv /usr/local/bin/uv; do
  [ -x "$candidate" ] && run "$candidate"
done

echo "walkie: could not find uv. Install it from https://docs.astral.sh/uv/ or set WALKIE_UV." >&2
exit 127
